# ================================================================
# vast-stack .env — copy thành .env (hoặc điền trong Portainer
# "Environment variables" khi tạo stack). KHÔNG commit file này.
# ================================================================

# --- BẮT BUỘC ---
VAST_API_KEY=
API_LLM_SERVER=
MANAGEMENT_PASSWORD=

# --- Tuỳ chọn ---
TZ=Europe/Paris
VAST_PROVIDER_NAME=ln.vastai
VAST_CLUSTER_LABEL=cpa-vllm
VAST_INSTANCE_IDS=
VAST_MANAGE_ALL_INSTANCES=false

REMOTE_LLM_PORT=18000
TUNNEL_SCAN_SECONDS=5

AUTO_SYNC_INSTANCES=true
AUTO_SCALE_ENABLED=true
IDLE_TIMEOUT_MINUTES=30
BOOT_GRACE_SECONDS=900
BOOT_POLL_SECONDS=5
SYNC_INTERVAL_SECONDS=60
HEALTH_CACHE_SECONDS=3
LANGUAGE_PROMPT=Always communicate and explain in Vietnamese (Tiếng Việt). Keep code syntax, terminal commands, variable names, and programming technical terms in English.

# config-sync: bật DRY_RUN=true để chỉ log trước khi cho phép ghi thật
CONFIG_SYNC_DRY_RUN=false

# CPA plugin store (nếu cần cài plugin qua store)
CPA_PLUGIN_GITHUB_TOKEN=
CPA_CODEX_COMPACTION_KEY=

# --- LITELLM (audio gateway, chạy song song CPA) ---
# BẮT BUỘC:
#   Master key = vừa là password GUI (/ui) vừa là key admin. Tự sinh:
#   python -c "import secrets; print('sk-litellm-'+secrets.token_hex(16))"
#   LITELLM_DB_PASSWORD: mật khẩu Postgres nội bộ (tự đặt)
LITELLM_MASTER_KEY=
LITELLM_DB_PASSWORD=

# Key của CPA mà LiteLLM dùng để delegate model cpa/* (chính là API key
# Hermes đang dùng để gọi CPA :8317)
CPA_API_KEY=

# Audio providers — chỉ điền key của provider định dùng, bỏ trống cái khác
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
